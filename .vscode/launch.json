{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug pipeline (local Gemma)",
            "type": "debugpy",
            "request": "launch",
            "python": "/opt/miniconda3/envs/dl/bin/python",
            "module": "heat_pump_ready",
            "cwd": "${workspaceFolder}",
            "args": ["--runner", "mlx", "--port", "8000"],
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "LLM_MODEL": "mlx-community/gemma-4-12B-it-4bit",
                "PYTHONUNBUFFERED": "1"
            }
        }
    ]
}
