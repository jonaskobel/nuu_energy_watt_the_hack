# Vorlage fuer VS Code: als .env speichern (wird von Git ignoriert).
# Im Terminal diese Werte als Umgebungsvariablen setzen; .env wird dort nicht automatisch geladen.
LLM_API_URL=
LLM_MODEL=
LLM_API_KEY=

# Claude alternativ ueber die Kompatibilitaetsschnittstelle:
# LLM_API_URL=https://api.anthropic.com/v1/chat/completions
# LLM_MODEL=claude-sonnet-5-5
# Optional fuer einen nicht an einen Workspace gebundenen Key:
# LLM_API_WORKSPACE_ID=
